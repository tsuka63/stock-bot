# ── Alpaca (US equities) ─────────────────────────────────────────────────────
# Free account at https://alpaca.markets gives access to historical data via IEX feed
APCA_API_KEY_ID=your_alpaca_key_here
APCA_API_SECRET_KEY=your_alpaca_secret_here

# ── J-Quants (Japanese equities) ─────────────────────────────────────────────
# Free account at https://jpx-jquants.com gives access to daily OHLCV data
#
# Option A — mail + password (re-authenticates on every run)
JQUANTS_API_MAIL_ADDRESS=your_email@example.com
JQUANTS_API_PASSWORD=your_password_here
#
# Option B — refresh token (preferred; valid for 1 week, obtained after first login)
# JQUANTS_API_REFRESH_TOKEN=your_refresh_token_here
